  "browse.metadata.inventorynumber": "Identifier",
  "browse.metadata.inventorynumber.breadcrumbs": "Browse by Identifier",
  "menu.section.browse_global_by_inventorynumber": "By Identifier",

  // Baptud: tree browses for the hierarchical_subjects_hu/en/de vocabularies, and
